# Frontend configuration. Copy to `.env` to override.
#
# Where the Flask backend is reachable. vue-cli inlines VUE_APP_* variables at build
# time, so changing this needs a restart of `npm run serve` (or a rebuild).
#
# The host spelling matters: a browser treats http://localhost:5000 and
# http://127.0.0.1:5000 as different origins, so whichever you set here must also
# appear in the backend's CORS_ORIGINS list.
VUE_APP_API_BASE_URL=http://127.0.0.1:5000
