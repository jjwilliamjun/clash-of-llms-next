# Copy to .env (or export directly) and fill in your own key.
# Requires a model at GPT-4 level or above.
OPENAI_API_KEY=sk-your-key-here

# Origins allowed to call the backend, comma separated. Defaults to the vue-cli dev
# server on both host spellings (http://localhost:8080 and http://127.0.0.1:8080).
# Set this when the frontend is served from somewhere else.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Port for the Flask API. run-backend.sh reads this; defaults to 5000.
# FLASK_PORT=5000
